+"""Durable, single-owner proactive rounds. No network operation is used as a receipt."""
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+import random
+import time
+import uuid
+from datetime import datetime
+from pathlib import Path
+from urllib.parse import urlparse
+
+from astrbot.api import logger
+
+
+STATES = {
+    "waiting": "等待触发", "recovery_wait": "恢复等待", "network_retry": "网络重试",
+    "schedule_pause": "日程暂停", "quiet_pause": "免打扰暂停", "cap_pause": "4 次暂停",
+    "running": "正在检查", "disabled": "已停用",
+}
+BACKOFF = (60, 120, 300, 900)
+
+
+def atomic_snapshot(path: Path, data: dict) -> None:
+    """Commit the newest snapshot to both files; either valid newest copy can recover."""
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    blob = json.dumps(data, ensure_ascii=False, indent=2).encode("utf-8")
+    for destination in (path.with_suffix(path.suffix + ".bak"), path):
+        temporary = destination.with_suffix(destination.suffix + ".tmp")
+        with temporary.open("wb") as stream:
+            stream.write(blob)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temporary, destination)
+
+
+def load_snapshot(path: Path) -> dict:
+    candidates, existed = [], False
+    for source in (Path(path), Path(str(path) + ".bak")):
+        if not source.exists():
+            continue
+        existed = True
+        try:
+            data = json.loads(source.read_text(encoding="utf-8"))
+            if not isinstance(data, dict) or any(not isinstance(v, dict) for v in data.values()):
+                raise ValueError("Invalid session snapshot")
+            candidates.append(data)
+        except (ValueError, OSError):
+            logger.error(f"[主动恢复] 状态副本不可读: {source.name}")
+    if not candidates and existed:
+        # Fail closed, rather than silently losing the four-round stop.
+        raise RuntimeError("主动消息状态及备份均不可读，暂停启动，禁止清零计数")
+    return max(candidates, key=lambda d: max((v.get("storage_revision", 0) for v in d.values()), default=0), default={})
+
+
+class RecoveryMixin:
+    RECOVERY_VERSION = "2026.10.28-r1"
+
+    async def initialize(self):
+        self._round_locks = {}
+        self._active_rounds = {}
+        self._recovery_task = None
+        self._last_watch = time.time()
+        self._last_probe = 0.0
+        self._network_ok = {}
+        self._storage_dirty = False
+        await super().initialize()
+        self._recovery_task = asyncio.create_task(self._recovery_loop())
+        logger.info(f"[主动恢复] {self.RECOVERY_VERSION} 已加载；30 秒巡检，60 秒连接检测")
+
+    async def terminate(self):
+        self._terminating = True
+        task = getattr(self, "_recovery_task", None)
+        if task:
+            task.cancel()
+            await asyncio.gather(task, return_exceptions=True)
+        # The scheduler cancellation below stops in-flight rounds. Their durable markers
+        # remain until startup, so an ambiguous send is never replayed.
+        await super().terminate()
+
+    async def _load_data_internal(self):
+        self.session_data = load_snapshot(Path(self.session_data_file))
+
+    async def _save_data_internal(self):
+        revision = max((v.get("storage_revision", 0) for v in self.session_data.values()), default=0) + 1
+        for state in self.session_data.values():
+            state["storage_revision"] = revision
+        try:
+            # Small local state: deliberately no yield between first ACK and durable count.
+            atomic_snapshot(Path(self.session_data_file), self.session_data)
+            self._storage_dirty = False
+        except OSError:
+            self._storage_dirty = True
+            raise
+
+    def _merge_session_info(self, base, incoming):
+        # Newer reply epochs/generations own their counter, including a genuine reset.
+        if "generation" in base or "generation" in incoming:
+            key = lambda d: (d.get("reply_epoch", 0), d.get("generation", 0), d.get("storage_revision", 0))
+            older, newer = sorted((base, incoming), key=key)
+            return {**older, **newer}
+        return super()._merge_session_info(base, incoming)
+
+    def _managed_sessions(self):
+        sessions = set(self.session_data)
+        sessions.update(self.session_override_manager.list_sessions())
+        for scope in ("friend_settings", "group_settings"):
+            settings = self.config.get(scope, {})
+            if settings.get("enable"):
+                for sid in settings.get("session_list", []):
+                    cfg = self._get_session_config(sid)
+                    if cfg:
+                        sessions.add(self._resolve_session_id_for_config(sid, cfg))
+        return sorted({self._normalize_session_id(s) for s in sessions
+                       if (self._get_session_config(s) or {}).get("enable")})
+
+    def _state(self, sid):
+        return self.session_data.setdefault(sid, {})
+
+    def _capped(self, sid):
+        cfg = self._get_session_config(sid) or {}
+        limit = int(cfg.get("schedule_settings", {}).get("max_unanswered_times", 4))
+        return limit > 0 and self._state(sid).get("unanswered_count", 0) >= limit
+
+    def _current(self, sid, token):
+        return not self._terminating and self._state(sid).get("generation", 0) == token
+
+    def _register(self, sid):
+        state = self._state(sid)
+        self._purge_related_jobs(sid)
+        due = state.get("next_trigger_time")
+        if due and not self._terminating:
+            self.scheduler.add_job(
+                self.check_and_chat, "date", run_date=datetime.fromtimestamp(due, self.timezone),
+                args=[sid, state.get("generation", 0)], id=sid, replace_existing=True,
+                misfire_grace_time=None, coalesce=True, max_instances=1,
+            )
+
+    def _add_chat_job(self, run_session_id, run_date):
+        # Legacy admin and group callers still use this interface. Capture a fresh token.
+        sid = self._normalize_session_id(run_session_id)
+        state = self._state(sid)
+        state["generation"] = state.get("generation", 0) + 1
+        state["next_trigger_time"] = run_date.timestamp()
+        self._register(sid)
+
+    async def _plan(self, sid, delay, status="waiting", reason="normal", token=None):
+        async with self.data_lock:
+            if token is not None and not self._current(sid, token):
+                return
+            if self._terminating:
+                return
+            state = self._state(sid)
+            state["generation"] = state.get("generation", 0) + 1
+            state.update(status=status, recovery_reason=reason, last_scheduled_at=time.time())
+            state["recovery_pending"] = status == "recovery_wait"
+            state["next_trigger_time"] = time.time() + delay if delay is not None else None
+            state["last_schedule_random_interval_seconds"] = delay
+            await self._save_data_internal()
+            self._register(sid)
+
+    async def _pause_cap(self, sid, token=None):
+        if self._state(sid).get("status") == "cap_pause" and not self._state(sid).get("next_trigger_time"):
+            self._purge_related_jobs(sid)
+            return
+        await self._plan(sid, None, "cap_pause", "unanswered_limit", token)
+
+    async def _recover(self, sid, reason, token=None):
+        if token is not None and not self._current(sid, token):
+            return
+        if self._capped(sid):
+            await self._pause_cap(sid, token)
+            return
+        state = self._state(sid)
+        # One durable deadline per unfinished episode, including overdue recovery waits.
+        if state.get("recovery_pending"):
+            if (state.get("next_trigger_time") or 0) > time.time():
+                self._register(sid)
+                return
+            # A previous recovery itself elapsed while the process was stopped/asleep.
+            # Start one new episode, then reuse it on repeated startup/wake notifications.
+            state["recovery_pending"] = False
+        state["recovery_pending"] = True
+        state["recovery_episode"] = uuid.uuid4().hex
+        delay = random.randint(300, 900)
+        state["recovery_delay_seconds"] = delay
+        await self._plan(sid, delay, "recovery_wait", reason, token)
+        logger.info(f"[主动恢复] {reason}：唯一恢复任务已注册，等待 {delay} 秒")
+
+    async def _init_jobs_from_data(self):
+        for sid in self._managed_sessions():
+            state = self._state(sid)
+            if self._capped(sid):
+                await self._pause_cap(sid)
+                continue
+            if state.get("inflight"):
+                # A process may stop after QQ accepted a message but before its ACK.
+                # Do not retry that payload; count only ACKs already committed.
+                if not state["inflight"].get("counted"):
+                    state["last_receipt"] = {"status": "unknown", "reason": "process_interrupted", "at": time.time(), "message_ids": []}
+                state["last_round"] = state.pop("inflight")
+            await self._recover(sid, "startup")
+        logger.info(f"[主动恢复] 启动恢复完成：{len(self.scheduler.get_jobs())} 个唯一任务")
+
+    async def _setup_auto_triggers_for_enabled_sessions(self):
+        # The watchdog owns recovery now; no parallel 30-minute bootstrap timer.
+        return
+
+    async def _schedule_next_chat_and_save(self, session_id, reset_counter=False):
+        sid = self._normalize_session_id(session_id)
+        cfg = self._get_session_config(sid) or {}
+        if not cfg.get("enable"):
+            return
+        state = self._state(sid)
+        if reset_counter:
+            state["unanswered_count"] = 0
+            state["reply_epoch"] = state.get("reply_epoch", 0) + 1
+            state["recovery_pending"] = False
+            state["retry_attempt"] = 0
+            # Invalidate a running round before yielding to any I/O.
+            state["generation"] = state.get("generation", 0) + 1
+        if self._capped(sid):
+            await self._pause_cap(sid)
+            return
+        schedule = cfg.get("schedule_settings", {})
+        lower = int(schedule.get("min_interval_minutes", 25)) * 60
+        upper = max(lower, int(schedule.get("max_interval_minutes", 120)) * 60)
+        state.update(last_schedule_min_interval_seconds=lower, last_schedule_max_interval_seconds=upper, recovery_pending=False)
+        await self._plan(sid, random.randint(lower, upper), reason="user_reply" if reset_counter else "normal")
+
+    async def _retry(self, sid, reason, token):
+        if not self._current(sid, token):
+            return
+        if self._capped(sid):
+            await self._pause_cap(sid, token)
+            return
+        state = self._state(sid)
+        attempt = state.get("retry_attempt", 0)
+        state["retry_attempt"] = attempt + 1
+        state["recovery_pending"] = False
+        await self._plan(sid, BACKOFF[min(attempt, 3)], "network_retry", reason, token)
+
+    async def _probe_session(self, sid):
+        """TCP reachability only. API availability/authentication still requires a receipt."""
+        from .proactive_event import resolve_platform_instance
+        platform = resolve_platform_instance(self.context.platform_manager, sid.split(":", 1)[0])
+        if platform is None:
+            return False
+        endpoints = set()
+        # QQ SDK's configured API origin; do not probe arbitrary public sites.
+        client = platform.get_client()
+        api = getattr(client, "api", None)
+        http = getattr(api, "_http", None)
+        for obj in (platform, api, http):
+            for key in ("base_url", "_base_url", "api_base", "base"):
+                value = getattr(obj, key, None)
+                if isinstance(value, str) and value.startswith(("http://", "https://")):
+                    endpoints.add(value)
+        if platform.meta().name == "qq_official" and not endpoints:
+            # The SDK selects these actual QQ API origins from its sandbox flag.
+            endpoints.add("https://sandbox.api.sgroup.qq.com" if getattr(client, "is_sandbox", False) else "https://api.sgroup.qq.com")
+        provider = await self._resolve_chat_provider(sid)
+        if provider is None:
+            return False
+        config = getattr(provider, "provider_config", {}) or {}
+        for key in ("api_base", "base_url", "api_base_url"):
+            value = config.get(key) or getattr(provider, key, None)
+            if isinstance(value, str) and value.startswith(("http://", "https://")):
+                endpoints.add(value)
+        if len(endpoints) < 2:
+            # Unknown endpoint configuration must not block custom providers forever.
+            logger.debug("[主动恢复] 仅检测可解析的已配置服务地址")
+        async def connect(url):
+            target = urlparse(url)
+            writer = None
+            try:
+                _, writer = await asyncio.wait_for(asyncio.open_connection(target.hostname, target.port or (443 if target.scheme == "https" else 80)), 3)
+                return True
+            except (OSError, asyncio.TimeoutError):
+                return False
+            finally:
+                if writer:
+                    writer.close()
+                    await asyncio.wait_for(writer.wait_closed(), 1)
+        results = await asyncio.gather(*(connect(e) for e in endpoints))
+        return bool(results) and all(results)
+
+    async def _watch_once(self, now=None, probe=True):
+        now = time.time() if now is None else now
+        woke = now - self._last_watch > 90
+        self._last_watch = now
+        if self._storage_dirty:
+            async with self.data_lock:
+                await self._save_data_internal()
+        for sid in self._managed_sessions():
+            if self._capped(sid):
+                await self._pause_cap(sid)
+                continue
+            if sid in self._active_rounds:
+                continue
+            if woke:
+                await self._recover(sid, "wake_or_loop_pause")
+            state = self._state(sid)
+            job = self.scheduler.get_job(sid)
+            if job and (len(job.args) < 2 or job.args[1] != state.get("generation", 0)):
+                if (state.get("next_trigger_time") or 0) > now:
+                    self._register(sid)
+                else:
+                    await self._recover(sid, "stale_task")
+            elif not job:
+                if state.get("recovery_pending"):
+                    self._register(sid)
+                else:
+                    await self._recover(sid, "missing_task")
+        if probe and now - self._last_probe >= 60:
+            self._last_probe = now
+            for sid in self._managed_sessions():
+                try:
+                    reachable = await self._probe_session(sid)
+                except Exception:
+                    reachable = False
+                previous = self._network_ok.get(sid)
+                self._network_ok[sid] = reachable
+                if reachable and previous is False and sid not in self._active_rounds:
+                    await self._recover(sid, "network_restored")
+
+    async def _recovery_loop(self):
+        while not self._terminating:
+            try:
+                if not self._startup_finalized and self._are_platforms_available():
+                    await self._finalize_startup()
+                if self._startup_finalized:
+                    await self._watch_once()
+            except asyncio.CancelledError:
+                raise
+            except Exception as exc:
+                logger.error(f"[主动恢复] 巡检失败，将于 30 秒后重试: {type(exc).__name__}")
+            await asyncio.sleep(30)
+
+    async def _accept_receipt(self, sid, token, round_id, receipt):
+        """The ONLY counter write on a successful delivery, shared by segments/hooks."""
+        async with self.data_lock:
+            state = self._state(sid)
+            state["last_receipt"] = {**receipt, "round_id": round_id, "at": time.time()}
+            inflight = state.get("inflight", {})
+            if inflight.get("id") == round_id:
+                inflight.setdefault("receipts", []).append(state["last_receipt"])
+                if receipt.get("status") == "confirmed" and receipt.get("message_ids") and not inflight.get("counted"):
+                    inflight["counted"] = True
+                    if self._current(sid, token):
+                        state["unanswered_count"] = state.get("unanswered_count", 0) + 1
+                        if self._capped(sid):
+                            state["status"] = "cap_pause"
+                            state["next_trigger_time"] = None
+            await self._save_data_internal()
+
+    async def _send_chain(self, session_id, event, components):
+        # No fallback replay after an exception or an unknown send outcome.
+        if not components or event is None or not hasattr(event, "_recovery_token"):
+            return False
+        from astrbot.core.message.message_event_result import MessageChain
+        return await event.send(MessageChain(list(components)))
+
+    async def check_and_chat(self, session_id, generation=None):
+        sid = self._normalize_session_id(session_id)
+        state = self._state(sid)
+        token = state.get("generation", 0) if generation is None else generation
+        lock = self._round_locks.setdefault(sid, asyncio.Lock())
+        if lock.locked() or not self._current(sid, token):
+            return
+        async with lock:
+            if not self._current(sid, token):
+                return
+            # An overdue callback may beat the watchdog after resume.
+            due = state.get("next_trigger_time", time.time()) or time.time()
+            if time.time() - self._last_watch > 90 or (time.time() - due > 60 and not state.get("recovery_pending")):
+                await self._recover(sid, "overdue_callback", token)
+                return
+            if self._capped(sid):
+                await self._pause_cap(sid, token)
+                return
+            self._active_rounds[sid] = token
+            event = None
+            try:
+                allowed, reason = await self._is_chat_allowed(sid)
+                if not allowed:
+                    await self._plan(sid, self._normal_delay(sid), "quiet_pause" if reason == "quiet_hours" else "disabled", reason, token)
+                    return
+                # Refresh connectivity before content generation, without model calls.
+                reachable = await self._probe_session(sid)
+                self._network_ok[sid] = reachable
+                if not reachable:
+                    await self._retry(sid, "endpoint_unreachable", token)
+                    return
+                if not self._current(sid, token):
+                    return
+                state.update(recovery_pending=False, status="running")
+                round_id = uuid.uuid4().hex
+                state["inflight"] = {"id": round_id, "generation": token, "counted": False, "phase": "generating", "started_at": time.time()}
+                async with self.data_lock:
+                    await self._save_data_internal()
+                package = await self._prepare_llm_request(sid)
+                if not package:
+                    await self._retry(sid, "context_unavailable", token)
+                    return
+                event = self._build_proactive_event(sid)
+                if event is None:
+                    await self._retry(sid, "event_unavailable", token)
+                    return
+                event._recovery_token = token
+                event._recovery_round_id = round_id
+                response, prompt = await asyncio.wait_for(self._generate_llm_response(
+                    sid, self._get_session_config(sid), package["history"], package["system_prompt"],
+                    state.get("unanswered_count", 0), event=event,
+                    conversation=package.get("conversation"), platform_context=package.get("platform_context", ""),
+                ), 300)
+                if not self._current(sid, token):
+                    return
+                if not response:
+                    guard = event.get_extra("schedule_guard.check") or {}
+                    if (guard.get("record") or {}).get("status") == "busy":
+                        await self._plan(sid, self._normal_delay(sid), "schedule_pause", "schedule_busy", token)
+                    elif event.is_stopped():
+                        await self._plan(sid, self._normal_delay(sid), "schedule_pause", "hook_stopped", token)
+                    else:
+                        await self._retry(sid, "model_failure", token)
+                    return
+                text = self._extract_response_text(response)
+                chain = self._extract_response_chain(response)
+                if not text and not chain:
+                    await self._retry(sid, "empty_model_response", token)
+                    return
+                await asyncio.wait_for(self._send_proactive_message(sid, text, event=event, initial_chain=chain), 180)
+                # Confirmation is authoritative even when the final segment/hook failed.
+                counted = state.get("inflight", {}).get("counted", False)
+                unknown = getattr(event, "proactive_outcome_unknown", False)
+                if not self._current(sid, token):
+                    return
+                if counted:
+                    state["retry_attempt"] = 0
+                    await self._finish_normal(sid, token)
+                    # Save only confirmed text; partial deliveries never claim the full text.
+                    confirmed_text = "".join(getattr(event, "proactive_confirmed_text", []))
+                    if confirmed_text:
+                        await self._archive_confirmed(sid, package["conv_id"], prompt, confirmed_text)
+                elif unknown:
+                    await self._finish_normal(sid, token)
+                elif event.is_stopped():
+                    await self._plan(sid, self._normal_delay(sid), "schedule_pause", "hook_stopped", token)
+                else:
+                    await self._retry(sid, "send_failed", token)
+            except asyncio.CancelledError:
+                raise
+            except Exception as exc:
+                logger.error(f"[主动恢复] 本轮异常: {type(exc).__name__}，保留回执与调度状态")
+                if self._current(sid, token):
+                    if state.get("inflight", {}).get("counted") or getattr(event, "proactive_outcome_unknown", False):
+                        await self._finish_normal(sid, token)
+                    else:
+                        await self._retry(sid, "round_exception", token)
+            finally:
+                self._active_rounds.pop(sid, None)
+                inflight = state.get("inflight")
+                if inflight and inflight.get("generation") == token:
+                    state["last_round"] = state.pop("inflight")
+                    async with self.data_lock:
+                        await self._save_data_internal()
+                await self._clear_manual_trigger_state(sid)
+
+    def _normal_delay(self, sid):
+        schedule = (self._get_session_config(sid) or {}).get("schedule_settings", {})
+        lower = int(schedule.get("min_interval_minutes", 25)) * 60
+        return random.randint(lower, max(lower, int(schedule.get("max_interval_minutes", 120)) * 60))
+
+    async def _finish_normal(self, sid, token):
+        if self._capped(sid):
+            await self._pause_cap(sid, token)
+        else:
+            await self._plan(sid, self._normal_delay(sid), token=token)
+
+    async def _archive_confirmed(self, sid, conv_id, prompt, text):
+        from astrbot.core.agent.message import AssistantMessageSegment, TextPart, UserMessageSegment
+        try:
+            await self.context.conversation_manager.add_message_pair(
+                cid=conv_id, user_message=UserMessageSegment(content=[TextPart(text=prompt)]),
+                assistant_message=AssistantMessageSegment(content=[TextPart(text=text)]),
+            )
+        except Exception as exc:
+            logger.error(f"[主动恢复] 已确认发送的消息存档失败，不重发: {type(exc).__name__}")
+
+    def recovery_status(self):
+        return [{"session": sid, "state": self._state(sid).get("status", "waiting"),
+                 "label": STATES.get(self._state(sid).get("status"), "等待触发"),
