+    async def send_by_session_with_receipt(self, session, message_chain, on_receipt=None) -> dict:
+        """Explicit QQ acceptance receipts; the existing send_by_session API is unchanged.
+
+        A returned message ID confirms QQ API acceptance, not that the human has read it.
+        Any transport exception without a definite QQ rejection is ambiguous.
+        """
+        receipt = {"status": "failed", "message_ids": [], "segments": []}
+        try:
+            await self._send_by_session_common(session, message_chain, receipt, on_receipt)
+        except Exception as exc:
+            # SDK ServerError carries an explicit API error code. Timeouts, connection
+            # resets and exceptions in post-send hooks must never trigger fallback replay.
+            code = getattr(exc, "code", None)
+            explicit_sdk_rejection = type(exc).__module__ == "botpy.errors"
+            outcome = "failed" if code is not None or explicit_sdk_rejection else "unknown"
+            receipt["status"] = outcome
+            receipt["reason"] = type(exc).__name__
+            receipt["segments"].append({"status": outcome})
+        if receipt["message_ids"]:
+            receipt["partial"] = receipt["status"] != "confirmed"
+            receipt["status"] = "confirmed"
+        return receipt
